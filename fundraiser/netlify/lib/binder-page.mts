os={},ball=null,dm=play.def||\"none\",xman={};\n  return play.steps.map(s=>{\n    if(s.o) pos=Object.assign({},pos,s.o);\n    if(s.ball) ball=s.ball;\n    if(s.dm) dm=s.dm;\n    if(s.x) xman=Object.assign({},xman,s.x);\n    const P={}; for(const k in pos) P[k]=pos[k].slice();\n    const X= dm===\"manual\"?Object.assign({},xman):defCalc(dm,P,ball,play);\n    if(s.xo) Object.assign(X,s.xo);\n    for(const k in X) P[k]=X[k].slice();\n    return {P,ball,shot:!!s.shot};\n  });\n}\n\n/* ---------- court ---------- */\nfunction courtSVG(full){\n  const L=[];\n  const half=(yb,dir)=>{\n    const y=v=>yb+dir*v, top=Math.min(y(0),y(190));\n    L.push(`<rect x=\"170\" y=\"${top}\" width=\"160\" height=\"190\" class=\"pt\"/>`);\n    L.push(`<path class=\"ln\" d=\"M170 ${y(0)} V${y(190)} H330 V${y(0)}\"/>`);\n    L.push(`<path class=\"ln\" d=\"M190 ${y(190)} A60 60 0 0 ${dir>0?0:1} 310 ${y(190)}\"/>`);\n    L.push(`<path class=\"ln dash\" d=\"M190 ${y(190)} A60 60 0 0 ${dir>0?1:0} 310 ${y(190)}\"/>`);\n    L.push(`<path class=\"ln\" d=\"M52.5 ${y(0)} V${y(52)} A197.5 197.5 0 0 ${dir>0?0:1} 447.5 ${y(52)} V${y(0)}\"/>`);\n    L.push(`<path class=\"ln\" d=\"M220 ${y(40)} H280\"/>`);\n    L.push(`<circle class=\"rim\" cx=\"250\" cy=\"${y(52)}\" r=\"9\"/>`);\n    [70,110,140,170].forEach(v=>L.push(`<path class=\"ln thin\" d=\"M162 ${y(v)} H170 M330 ${y(v)} H338\"/>`));\n    L.push(`<path class=\"ln\" d=\"M0 ${y(0)} H500\"/>`);\n  };\n  if(!full){\n    L.push(`<rect x=\"0\" y=\"20\" width=\"500\" height=\"450\" class=\"fl\"/>`);\n    half(20,1);\n    L.push(`<path class=\"ln\" d=\"M0 20 V470 H500 V20\"/>`);\n    L.push(`<path class=\"ln\" d=\"M190 470 A60 60 0 0 1 310 470\"/>`);\n  }else{\n    L.push(`<rect x=\"0\" y=\"20\" width=\"500\" height=\"900\" class=\"fl\"/>`);\n    half(20,1); half(920,-1);\n    L.push(`<path class=\"ln\" d=\"M0 20 V920 M500 20 V920 M0 470 H500\"/>`);\n    L.push(`<circle class=\"ln\" cx=\"250\" cy=\"470\" r=\"60\"/>`);\n    L.push(`<text x=\"12\" y=\"955\" class=\"lbltxt\">INBOUND SIDE</text>`);\n    L.push(`<text x=\"488\" y=\"462\" class=\"lbltxt\" text-anchor=\"end\">HALF COURT</text>`);\n  }\n  return L.join(\"\");\n}\n\n/* ---------- path helpers ---------- */\nfunction plen(pts){let s=0;for(let i=1;i<pts.length;i++)s+=dist(pts[i-1],pts[i]);return s}\nfunction pointAt(pts,t){\n  const L=plen(pts); if(L===0) return pts[0].slice();\n  let d=Math.max(0,Math.min(1,t))*L;\n  for(let i=1;i<pts.length;i++){const s=dist(pts[i-1],pts[i]); if(d<=s||i===pts.length-1){const k=s?Math.min(1,d/s):0; return [pts[i-1][0]+(pts[i][0]-pts[i-1][0])*k,pts[i-1][1]+(pts[i][1]-pts[i-1][1])*k]} d-=s;}\n  return pts[pts.length-1].slice();\n}\nfunction trim(pts,a,b){const L=plen(pts); if(L<a+b+4) return null; const n=[]; const steps=Math.max(2,Math.ceil(L/6)); for(let i=0;i<=steps;i++){n.push(pointAt(pts,(a+(L-a-b)*i/steps)/L))} return n}\nfunction simplify(pts){return pts}\nconst dP=pts=>\"M\"+pts.map(p=>p[0].toFixed(1)+\" \"+p[1].toFixed(1)).join(\" L\");\nfunction zig(pts){\n  const L=plen(pts), out=[pts[0]], body=L-16, n=Math.max(3,Math.floor(body/9));\n  for(let k=1;k<=n;k++){const t=(k/(n+1))*body/L, p=pointAt(pts,t), q=pointAt(pts,Math.min(1,t+.02)); const u=unit(sub(q,p)); const s=(k%2?1:-1)*5; out.push([p[0]-u[1]*s,p[1]+u[0]*s]);}\n  out.push(pointAt(pts,(L-10)/L)); out.push(pts[pts.length-1]); return out;\n}\n\n/* ---------- text helpers ---------- */\n// {3} is player 3 on offense, {x3} is defensive player 3\nconst fmt=s=>String(s).replace(/\\{x([1-5])\\}/g,'<span class=\"dn\">$1</span>').replace(/\\{([1-5])\\}/g,'<span class=\"pn\">$1</span>');\nconst plain=s=>String(s).replace(/\\{x?([1-5])\\}/g,\"$1\");\nconst esc=s=>String(s).replace(/[&<>\"]/g,c=>({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\"}[c]));\nconst $=id=>document.getElementById(id);\nconst NS=\"http://www.w3.org/2000/svg\";\nconst reduce=window.matchMedia&&matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\nconst store={\n  get(k,d){try{const v=localStorage.getItem(\"lbPlaybook.\"+k);return v==null?d:JSON.parse(v)}catch(e){return d}},\n  set(k,v){try{localStorage.setItem(\"lbPlaybook.\"+k,JSON.stringify(v))}catch(e){}}\n};\nconst ORDER=[\"flow\",\"princeton\",\"z41\",\"man\",\"zone\",\"spec\",\"press\"];\nconst ALL=ORDER.flatMap(s=>PLAYS.filter(p=>p.sys===s));\nconst byId=id=>PLAYS.find(p=>p.id===id);\n\n/* ---------- animated court viewer ---------- */\nlet vid=0;\nfunction Viewer(svg,opt){\n  opt=opt||{};\n  const uid=\"v\"+(++vid);\n  let play=null,F=[],cur=0,t=0,playing=false,raf=0,hold=0,lastTs=0,restart=false;\n  let gA,gX,gO,gB,nodes={},ballNode;\n  const DUR=1600;\n  const speed=()=>opt.speed?opt.speed():1;\n  function el(tag,attrs,parent){const e=document.createElementNS(NS,tag);for(const k in attrs)e.setAttribute(k,attrs[k]);if(parent)parent.appendChild(e);return e}\n  function setup(){\n    const full=play.court===\"full\";\n    svg.setAttribute(\"viewBox\",full?\"-8 12 516 956\":\"-8 12 516 466\");\n    if(opt.stage) opt.stage.classList.toggle(\"full\",full);\n    svg.innerHTML=`<defs>\n      <marker id=\"${uid}ah\" viewBox=\"0 0 10 10\" refX=\"7\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\"><path d=\"M0 0L10 5L0 10z\" class=\"ahp\"/></marker>\n      <marker id=\"${uid}ahx\" viewBox=\"0 0 10 10\" refX=\"7\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\"><path d=\"M0 0L10 5L0 10z\" class=\"ahx\"/></marker>\n    </defs>${courtSVG(full)}`;\n    gA=el(\"g\",{},svg); gX=el(\"g\",{},svg); gO=el(\"g\",{},svg); gB=el(\"g\",{},svg);\n    nodes={};\n    const ids=new Set(); F.forEach(f=>Object.keys(f.P).forEach(k=>ids.add(k)));\n    [...ids].sort().forEach(id=>{\n      if(id[0]===\"o\"){const g=el(\"g\",{class:\"of\"},gO); el(\"circle\",{r:13},g); const tx=el(\"text\",{\"text-anchor\":\"middle\",y:5},g); tx.textContent=id.slice(1); nodes[id]=g;}\n      else{const g=el(\"g\",{class:\"df\"},gX); el(\"path\",{d:\"M-8 -8L8 8M8 -8L-8 8\"},g); const tx=el(\"text\",{x:10,y:14},g); tx.textContent=id.slice(1); nodes[id]=g;}\n    });\n    ballNode=el(\"circle\",{r:6.5,class:\"bl\"},gB);\n  }\n  function moverPath(id,i){\n    const a=F[i].P[id], b=F[i+1]&&F[i+1].P[id]; if(!a||!b) return null;\n    const via=(play.steps[i+1].via||{})[id]||[];\n    return [a,...via,b];\n  }\n  const ease=x=>x<.5?2*x*x:1-Math.pow(-2*x+2,2)/2;\n  const passWin=i=>(play.steps[i+1].pass===\"start\")?[0,.4]:[.55,1];\n  function playerPos(id,i,tt){\n    const f=F[i].P[id]; if(!F[i+1]||tt<=0) return f||(F[i+1]&&F[i+1].P[id]);\n    const p=moverPath(id,i); if(!p) return F[i+1].P[id]||f;\n    return pointAt(p,ease(tt));\n  }\n  function holderPos(id,i,tt){const p=playerPos(id,i,tt); return p?[p[0]+9,p[1]-9]:RIM}\n  function ballPos(i,tt){\n    const f=F[i]; if(!F[i+1]||tt<=0) return f.shot?[RIM[0],RIM[1]]:holderPos(f.ball,i,0);\n    if(f.shot) return [RIM[0],RIM[1]];\n    const n=F[i+1], a=f.ball, b=n.ball;\n    if(n.shot){ if(tt<.35) return holderPos(a,i,tt); const k=(tt-.35)/.65, s=holderPos(a,i,.35); return [s[0]+(RIM[0]-s[0])*k, s[1]+(RIM[1]-s[1])*k - Math.sin(Math.PI*k)*60];}\n    if(a===b) return holderPos(a,i,tt);\n    const [w0,w1]=passWin(i);\n    if(tt<=w0) return holderPos(a,i,tt);\n    if(tt>=w1) return holderPos(b,i,tt);\n    const k=(tt-w0)/(w1-w0), s=holderPos(a,i,w0), e=holderPos(b,i,w1);\n    return [s[0]+(e[0]-s[0])*k, s[1]+(e[1]-s[1])*k];\n  }\n  function drawArrows(i){\n    gA.innerHTML=\"\";\n    if(i>=F.length-1) return;\n    const s=play.steps[i+1], a=F[i], n=F[i+1], scr=s.scr||[];\n    const AH=`url(#${uid}ah)`, AHX=`url(#${uid}ahx)`;\n    for(const id in n.P){\n      const p=moverPath(id,i); if(!p) continue;\n      if(dist(p[0],p[p.length-1])<4&&p.length<3) continue;\n      const isX=id[0]===\"x\";\n      if(isX&&!play.xArrows) continue;\n      const dribble=!isX&&id===a.ball&&(a.ball===n.ball||s.pass!==\"start\")&&!a.shot;\n      const pts=trim(p,isX?12:15,isX?4:(scr.includes(id)?0:2)); if(!pts) continue;\n      if(scr.includes(id)){\n        el(\"path\",{d:dP(pts),class:\"mv\"},gA);\n        const e=pts[pts.length-1], u=unit(sub(e,pts[pts.length-3]||pts[0]));\n        el(\"path\",{d:`M${e[0]-u[1]*11} ${e[1]+u[0]*11} L${e[0]+u[1]*11} ${e[1]-u[0]*11}`,class:\"mv\",style:\"stroke-width:3\"},gA);\n      }else if(dribble){\n        el(\"path\",{d:dP(zig(pts)),class:\"mv\",\"marker-end\":AH},gA);\n      }else{\n        el(\"path\",{d:dP(pts),class:\"mv\"+(isX?\" x\":\"\"),\"marker-end\":isX?AHX:AH},gA);\n      }\n    }\n    if(n.shot&&!a.shot){\n      const h=a.P[a.ball]; const pts=[h,[(h[0]+RIM[0])/2, Math.min(h[1],RIM[1])+(h[1]-RIM[1])/2-40],RIM];\n      const tp=trim(pts,15,10); if(tp) el(\"path\",{d:dP(tp),class:\"mv pass\",\"marker-end\":AH},gA);\n    }else if(a.ball!==n.ball){\n      const tp=trim([a.P[a.ball],n.P[n.ball]],16,16); if(tp) el(\"path\",{d:dP(tp),class:\"mv pass\",\"marker-end\":AH},gA);\n    }\n  }\n  function render(){\n    for(const id in nodes){\n      const p=playerPos(id,cur,t);\n      if(!p){nodes[id].setAttribute(\"visibility\",\"hidden\");continue}\n      nodes[id].setAttribute(\"visibility\",\"visible\");\n      nodes[id].setAttribute(\"transform\",`translate(${p[0].toFixed(1)} ${p[1].toFixed(1)})`);\n    }\n    const b=ballPos(cur,t); ballNode.setAttribute(\"cx\",b[0].toFixed(1)); ballNode.setAttribute(\"cy\",b[1].toFixed(1));\n    gA.style.opacity=t>0?Math.max(0,1-t*2.2):1;\n    if(opt.bar) opt.bar.style.width=((cur+t)/(F.length-1||1)*100)+\"%\";\n  }\n  const notify=()=>{if(opt.onStep) opt.onStep(api)};\n  function tick(ts){\n    if(!lastTs) lastTs=ts;\n    const dt=Math.min(ts-lastTs,100); lastTs=ts;\n    if(hold>0){hold-=dt; raf=requestAnimationFrame(tick); return}\n    if(restart){restart=false; cur=0; t=0; drawArrows(0); render(); notify(); hold=700; raf=requestAnimationFrame(tick); return}\n    t+=dt/(reduce?250:DUR/speed());\n    if(t>=1){\n      cur++; t=0; drawArrows(cur); render(); notify();\n      if(cur>=F.length-1){\n        if(opt.loop&&playing){hold=2200; restart=true; raf=requestAnimationFrame(tick); return}\n        playing=false; stop(); notify(); return;\n      }\n      if(!playing){stop(); notify(); return}\n      hold=reduce?600:900/speed();\n    }\n    render();\n    raf=requestAnimationFrame(tick);\n  }\n  function loop(){cancelAnimationFrame(raf); lastTs=0; raf=requestAnimationFrame(tick)}\n  function stop(){cancelAnimationFrame(raf); raf=0}\n  function go(i){playing=false; restart=false; stop(); cur=Math.max(0,Math.min(F.length-1,i)); t=0; drawArrows(cur); render(); notify()}\n  const api={\n    load(p){play=p; F=buildFrames(p); setup(); go(0)},\n    go,\n    next(){if(cur>=F.length-1) return; playing=false; hold=0; notify(); loop()},\n    toggle(){\n      if(playing){playing=false; stop(); if(t>0){t=0; render()} notify(); return}\n      if(cur>=F.length-1) go(0);\n      playing=true; hold=0; notify(); loop();\n    },\n    start(){if(!playing) api.toggle()},\n    pause(){if(playing) api.toggle()},\n    get cur(){return cur}, get t(){return t}, get n(){return F.length}, get playing(){return playing}, get play(){return play}\n  };\n  return api;\n}\n\n/* ---------- progress ---------- */\nlet learned=new Set(store.get(\"learned\",[]));\nfunction setLearned(id,on){on?learned.add(id):learned.delete(id); store.set(\"learned\",[...learned]); refreshProgress()}\nfunction refreshProgress(){\n  $(\"learnPill\").innerHTML=`<b>${learned.size}</b> of ${ALL.length} learned`;\n  const next=ALL.find(p=>!learned.has(p.id));\n  $(\"startLbl\").textContent=learned.size===0?\"Start learning\":next?\"Keep going: \"+next.name:\"Review the plays\";\n  document.querySelectorAll(\"[data-learn]\").forEach(e=>e.classList.toggle(\"learned\",learned.has(e.dataset.learn)));\n  document.querySelectorAll(\"[data-chk]\").forEach(e=>e.classList.toggle(\"on\",learned.has(e.dataset.chk)));\n  document.querySelectorAll(\"[data-meter]\").forEach(e=>{\n    const ps=PLAYS.filter(p=>p.sys===e.dataset.meter), k=ps.filter(p=>learned.has(p.id)).length;\n    e.querySelector(\"i\").style.width=(k/ps.length*100)+\"%\";\n    e.nextElementSibling.textContent=k+\"/\"+ps.length;\n  });\n  if(current){const on=learned.has(current.id); $(\"learnBtn\").setAttribute(\"aria-pressed\",on); $(\"learnLbl\").textContent=on?\"Learned\":\"Mark as learned\"}\n}\n\n/* ---------- videos ---------- */\nconst VIDS=new Map();\nORDER.forEach(sid=>{\n  PLAYS.filter(p=>p.sys===sid).forEach(p=>(p.vids||[]).forEach(([id,title])=>{\n    if(!VIDS.has(id)) VIDS.set(id,{id,title,sys:new Set(),plays:[]});\n    const v=VIDS.get(id); v.sys.add(sid); if(!v.plays.includes(p.id)) v.plays.push(p.id);\n  }));\n  (SYSTEMS[sid].vids||[]).forEach(([id,title])=>{\n    if(!VIDS.has(id)) VIDS.set(id,{id,title,sys:new Set(),plays:[]});\n    VIDS.get(id).sys.add(sid);\n  });\n});\nfunction vidCard(v,tags){\n  const t=esc(v.title);\n  return `<article class=\"vcard\">\n    <div class=\"yt\" data-yt=\"${v.id}\"><button type=\"button\" aria-label=\"Play video: ${t}\"><img loading=\"lazy\" src=\"https://i.ytimg.com/vi/${v.id}/hqdefault.jpg\" alt=\"\" onerror=\"this.style.visibility='hidden'\"><span class=\"play\"><svg viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg></span></button></div>\n    <div class=\"vmeta\"><b>${t}</b>${tags?`<div class=\"vtags\">${tags}</div>`:\"\"}\n    <span class=\"vfall\">Video will not play? <a href=\"https://www.youtube.com/watch?v=${v.id}\" target=\"_blank\" rel=\"noopener\">Watch on YouTube</a></span></div>\n  </article>`;\n}\ndocument.addEventListener(\"click\",e=>{\n  const b=e.target.closest(\".yt button\"); if(!b) return;\n  const box=b.parentElement, id=box.dataset.yt;\n  document.querySelectorAll(\".yt iframe\").forEach(f=>{const o=f.parentElement; o.innerHTML=o.dataset.idle||\"\"});\n  box.dataset.idle=box.innerHTML;\n  box.innerHTML=`<iframe src=\"https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1\" title=\"${esc(b.getAttribute(\"aria-label\"))}\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" allowfullscreen></iframe>`;\n  if(main) main.pause(); if(quizV) quizV.pause();\n});\n\n/* ---------- routing ---------- */\nlet current=null, route=\"home\";\nfunction show(view){\n  [\"home\",\"play\",\"film\",\"quiz\"].forEach(v=>$(\"v-\"+v).hidden=v!==view);\n  const tab=view===\"play\"?\"plays\":view;\n  document.querySelectorAll(\".tab\").forEach(t=>t.setAttribute(\"aria-current\",t.dataset.go===tab?\"page\":\"false\"));\n  if(view===\"home\"){ if(!reduce) hero.start(); } else hero.pause();\n  if(view!==\"play\"&&main) main.pause();\n  if(view!==\"quiz\"&&quizV) quizV.pause();\n  document.querySelectorAll(\".yt iframe\").forEach(f=>{const o=f.parentElement; o.innerHTML=o.dataset.idle||\"\"});\n}\nfunction nav(where){\n  if(where===\"plays\") where=(current&&current.id)||store.get(\"last\",ALL[0].id);\n  if(location.hash.slice(1)===where) handle(); else location.hash=where;\n}\nfunction handle(){\n  const h=location.hash.slice(1)||\"home\";\n  if(h===\"home\"||h===\"film\"||h===\"quiz\"){\n    route=h; show(h);\n    if(h===\"quiz\"&&!quizV.play) newQuestion();\n    if(h===\"quiz\"&&quizV.play) quizV.start();\n  }else{\n    const p=byId(h); if(!p){route=\"home\";show(\"home\");return}\n    route=\"play\"; show(\"play\"); if(!current||current.id!==p.id) loadPlay(p);\n  }\n  window.scrollTo(0,0);\n}\ndocument.addEventListener(\"click\",e=>{const b=e.target.closest(\"[data-go]\"); if(b){e.preventDefault(); nav(b.dataset.go)}});\nwindow.addEventListener(\"hashchange\",handle);\n\n/* ---------- theme ---------- */\n$(\"themeBtn\").addEventListener(\"click\",()=>{\n  const r=document.documentElement, dark=r.dataset.theme?r.dataset.theme===\"dark\":matchMedia(\"(prefers-color-scheme: dark)\").matches;\n  r.dataset.theme=dark?\"light\":\"dark\"; store.set(\"theme\",r.dataset.theme);\n});\n{const th=store.get(\"theme\",null); if(th) document.documentElement.dataset.theme=th;}\n\n/* ---------- home ---------- */\nconst hero=Viewer($(\"heroCourt\"),{loop:true});\nconst HERO_ORDER=[\"flow\",\"river\",\"point_over\",\"z23\",\"p21\"].map(byId).filter(p=>p.court!==\"full\");\nlet heroIdx=0;\nfunction heroLoad(){const p=HERO_ORDER[heroIdx%HERO_ORDER.length]; hero.load(p); $(\"heroName\").textContent=SYSTEMS[p.sys].name+\": \"+p.name}\n$(\"heroOpen\").addEventListener(\"click\",()=>nav(HERO_ORDER[heroIdx%HERO_ORDER.length].id));\nfunction buildHome(){\n  $(\"sPlays\").textContent=ALL.length; $(\"sSystems\").textContent=ORDER.length; $(\"sVids\").textContent=VIDS.size;\n  let html=\"\";\n  [\"Offense\",\"Defense\"].forEach(side=>{\n    const sys=ORDER.filter(s=>SYSTEMS[s].side===side), n=PLAYS.filter(p=>SYSTEMS[p.sys].side===side).length;\n    html+=`<div class=\"side-card\"><div class=\"side-head${side===\"Defense\"?\" def\":\"\"}\"><h3>${side}</h3><small>${sys.length} systems, ${n} plays</small></div><ul class=\"sys-list\">`;\n    sys.forEach(sid=>{\n      const s=SYSTEMS[sid], ps=PLAYS.filter(p=>p.sys===sid);\n      html+=`<li><div class=\"sys-btn\">\n        <button type=\"button\" class=\"sys-go\" data-go=\"${ps[0].id}\"><span class=\"nm\">${s.name}</span><span class=\"ds\">${s.sub}</span></button>\n        <span class=\"ct\"><span class=\"meter\" data-meter=\"${sid}\"><i></i></span><span></span></span>\n        <div class=\"plays-inline\">${ps.map(p=>`<button type=\"button\" class=\"mini\" data-go=\"${p.id}\" data-learn=\"${p.id}\">${esc(p.name)}</button>`).join(\"\")}</div>\n      </div></li>`;\n    });\n    html+=`</ul></div>`;\n  });\n  $(\"sides\").innerHTML=html;\n  $(\"startBtn\").addEventListener(\"click\",()=>{const next=ALL.find(p=>!learned.has(p.id))||ALL[0]; nav(next.id)});\n}\n\n/* ---------- play view ---------- */\nlet speed=1;\nconst main=Viewer($(\"court\"),{stage:$(\"stage\"),bar:$(\"bar\"),speed:()=>speed,onStep:updateText});\nfunction updateText(v){\n  if(!current) return;\n  const n=v.n, k=Math.min(v.cur+1,n-1), s=current.steps[k], done=v.cur>=n-1;\n  $(\"capk\").innerHTML=`Step ${k} of ${n-1}`+(s.tag?`<em>${s.tag}</em>`:\"\")+(done?`<em>Finished</em>`:\"\");\n  $(\"capt\").innerHTML=fmt(s.t);\n  document.querySelectorAll(\"#stepList li\").forEach((li,j)=>{const idx=j+1; li.classList.toggle(\"on\",idx===k); li.classList.toggle(\"done\",idx<k)});\n  $(\"bPrev\").disabled=v.cur===0&&v.t===0;\n  $(\"bNext\").disabled=done;\n  $(\"playLbl\").textContent=v.playing?\"Pause\":(done?\"Replay\":\"Play\");\n  $(\"playIcon\").innerHTML=v.playing?'<path d=\"M7 5h4v14H7zM13 5h4v14h-4z\"/>':(done?'<path d=\"M12 5V2L7 6l5 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z\"/>':'<path d=\"M8 5v14l11-7z\"/>');\n}\nfunction buildNav(){\n  let html=`<input class=\"search\" id=\"search\" type=\"search\" placeholder=\"Search plays\" aria-label=\"Search plays\">`, opt=\"\", side=\"\";\n  ORDER.forEach(sid=>{\n    const s=SYSTEMS[sid];\n    if(s.side!==side){html+=`<h2 class=\"${s.side===\"Defense\"?\"def\":\"\"}\">${s.side}</h2>`; side=s.side}\n    html+=`<div class=\"grp\" data-grp=\"${sid}\">${s.name}</div><ul data-ul=\"${sid}\">`;\n    opt+=`<optgroup label=\"${s.side}: ${s.name}\">`;\n    PLAYS.filter(p=>p.sys===sid).forEach(p=>{\n      html+=`<li data-q=\"${esc((p.name+\" \"+(p.aka||\"\")+\" \"+s.name+\" \"+(p.call||\"\")).toLowerCase())}\"><button type=\"button\" data-id=\"${p.id}\"><span>${esc(p.name)}</span><span class=\"chk\" data-chk=\"${p.id}\"></span></button></li>`;\n      opt+=`<option value=\"${p.id}\">${esc(p.name)}</option>`;\n    });\n    html+=\"</ul>\"; opt+=\"</optgroup>\";\n  });\n  $(\"side\").innerHTML=html; $(\"pick\").innerHTML=opt;\n  $(\"search\").addEventListener(\"input\",e=>{\n    const q=e.target.value.trim().toLowerCase();\n    document.querySelectorAll(\"#side li\").forEach(li=>li.hidden=q&&!li.dataset.q.includes(q));\n    ORDER.forEach(sid=>{const any=[...document.querySelectorAll(`[data-ul=\"${sid}\"] li`)].some(li=>!li.hidden); document.querySelector(`[data-grp=\"${sid}\"]`).hidden=!any});\n  });\n}\nfunction loadPlay(p){\n  current=p; store.set(\"last\",p.id);\n  const sys=SYSTEMS[p.sys];\n  $(\"eyebrow\").textContent=sys.side+\" · \"+sys.name;\n  $(\"title\").textContent=p.name;\n  const chips=[];\n  if(p.call) chips.push([\"Call\",p.call]);\n  if(p.aka) chips.push([\"Also called\",p.aka]);\n  chips.push([\"Use vs\",p.target]);\n  chips.push([sys.side===\"Offense\"?\"Look for\":\"Goal\",p.look]);\n  $(\"chips\").innerHTML=chips.map(c=>`<span class=\"chip\"><b>${c[0]}</b>${fmt(esc(c[1]))}</span>`).join(\"\");\n  $(\"setup\").innerHTML=fmt(p.steps[0].t);\n  $(\"stepCount\").textContent=(p.steps.length-1)+\" steps\";\n  $(\"stepList\").innerHTML=p.steps.slice(1).map((s,j)=>`<li><button type=\"button\" data-k=\"${j+1}\"><span class=\"num\">${j+1}</span><span>${s.tag?`<span class=\"tag\">${s.tag}</span>`:\"\"}${fmt(s.t)}</span></button></li>`).join(\"\");\n  $(\"keys\").innerHTML=p.keys.map(k=>`<li>${fmt(k)}</li>`).join(\"\");\n  $(\"sysrules\").innerHTML=`<h3>${sys.side===\"Offense\"?esc(sys.name)+\" rules\":\"Defensive non negotiables\"}</h3><ul>${sys.rules.map(r=>`<li>${fmt(r)}</li>`).join(\"\")}</ul>`;\n  const ids=[...(p.vids||[]),...(sys.vids||[])].map(v=>v[0]).filter((v,i,a)=>a.indexOf(v)===i);\n  $(\"playVids\").innerHTML=ids.map(id=>vidCard(VIDS.get(id))).join(\"\");\n  $(\"filmNote\").textContent=(p.sys===\"flow\"||p.sys===\"princeton\")?\"These clips show the same concepts run by other teams. The animation above is our exact version.\":\"Our play names are our own, so the clips use different names. They show the same concept, and the animation above is our exact version.\";\n  const i=ALL.indexOf(p), prev=ALL[i-1], next=ALL[i+1];\n  $(\"playnav\").innerHTML=(prev?`<button type=\"button\" data-go=\"${prev.id}\"><small>Previous play</small><b>${esc(prev.name)}</b></button>`:\"<span></span>\")+(next?`<button type=\"button\" data-go=\"${next.id}\"><small>Next play</small><b>${esc(next.name)}</b></button>`:\"\");\n  document.querySelectorAll(\"#side button[data-id]\").forEach(b=>b.setAttribute(\"aria-current\",b.dataset.id===p.id?\"true\":\"false\"));\n  $(\"pick\").value=p.id;\n  main.load(p);\n  refreshProgress();\n}\n$(\"side\").addEventListener(\"click\",e=>{const b=e.target.closest(\"button[data-id]\"); if(b) nav(b.dataset.id)});\n$(\"pick\").addEventListener(\"change\",e=>nav(e.target.value));\n$(\"stepList\").addEventListener(\"click\",e=>{const b=e.target.closest(\"button[data-k]\"); if(b) main.go(+b.dataset.k-1)});\n$(\"bPlay\").addEventListener(\"click\",()=>main.toggle());\n$(\"bNext\").addEventListener(\"click\",()=>main.next());\n$(\"bPrev\").addEventListener(\"click\",()=>main.go(main.t>0?main.cur:main.cur-1));\n$(\"bRestart\").addEventListener(\"click\",()=>main.go(0));\n$(\"bSpeed\").addEventListener(\"click\",()=>{speed=speed===1?0.5:speed===0.5?1.5:1; $(\"spd\").textContent=speed+\"x\"});\n$(\"learnBtn\").addEventListener(\"click\",()=>setLearned(current.id,!learned.has(current.id)));\ndocument.addEventListener(\"keydown\",e=>{\n  if(route!==\"play\"||e.target.closest(\"select,input,textarea\")) return;\n  if(e.key===\" \"&&e.target.closest(\"button\")) return;\n  if(e.key===\" \"){e.preventDefault();main.toggle()} else if(e.key===\"ArrowRight\") main.next(); else if(e.key===\"ArrowLeft\") main.go(main.cur-1);\n});\n\n/* ---------- film room ---------- */\nlet filmFilter=store.get(\"film\",\"all\");\nfunction buildFilm(){\n  const opts=[[\"all\",\"All film\"],...ORDER.map(s=>[s,SYSTEMS[s].name])];\n  $(\"filters\").innerHTML=opts.map(([k,l])=>`<button type=\"button\" class=\"filter\" data-f=\"${k}\" aria-pressed=\"${k===filmFilter}\">${esc(l)}</button>`).join(\"\");\n  const list=[...VIDS.values()].filter(v=>filmFilter===\"all\"||v.sys.has(filmFilter));\n  $(\"filmGrid\").innerHTML=list.map(v=>{\n    const tags=v.plays.length?v.plays.map(id=>{const p=byId(id); return `<button type=\"button\" data-go=\"${id}\">${esc(p.name)}</button>`}).join(\"\"):[...v.sys].map(s=>{const first=PLAYS.find(p=>p.sys===s); return `<button type=\"button\" data-go=\"${first.id}\">${esc(SYSTEMS[s].name)}</button>`}).join(\"\");\n    return vidCard(v,tags);\n  }).join(\"\");\n}\n$(\"filters\").addEventListener(\"click\",e=>{const b=e.target.closest(\"[data-f]\"); if(!b) return; filmFilter=b.dataset.f; store.set(\"film\",filmFilter); buildFilm()});\n\n/* ---------- quiz ---------- */\nconst quizV=Viewer($(\"qcourt\"),{stage:$(\"qstage\"),bar:$(\"qbar\"),onStep:v=>{$(\"qstep\").textContent=v.cur>=v.n-1?\"Finished\":\"Step \"+Math.min(v.cur+1,v.n-1)+\" of \"+(v.n-1)}});\nlet qPool=store.get(\"qpool\",\"all\"), qAns=null, qDone=false, qLast=null;\nlet qs=store.get(\"quiz\",{score:0,streak:0,best:0});\nfunction qScore(){$(\"qScore\").textContent=qs.score; $(\"qStreak\").textContent=qs.streak; $(\"qBest\").textContent=qs.best; store.set(\"quiz\",qs)}\nfunction buildQFilters(){\n  const opts=[[\"all\",\"All plays\"],[\"Offense\",\"Offense only\"],[\"Defense\",\"Defense only\"]];\n  $(\"qfilters\").innerHTML=opts.map(([k,l])=>`<button type=\"button\" class=\"filter\" data-q=\"${k}\" aria-pressed=\"${k===qPool}\">${l}</button>`).join(\"\");\n}\n$(\"qfilters\").addEventListener(\"click\",e=>{const b=e.target.closest(\"[data-q]\"); if(!b) return; qPool=b.dataset.q; store.set(\"qpool\",qPool); buildQFilters(); newQuestion()});\nconst shuffle=a=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]} return a};\nfunction newQuestion(){\n  const pool=ALL.filter(p=>qPool===\"all\"||SYSTEMS[p.sys].side===qPool);\n  let p; do{p=pool[Math.floor(Math.random()*pool.length)]}while(pool.length>1&&p===qLast);\n  qLast=p; qAns=p; qDone=false;\n  const same=shuffle(pool.filter(x=>x!==p&&SYSTEMS[x.sys].side===SYSTEMS[p.sys].side));\n  const opts=shuffle([p,...same.slice(0,3)]);\n  $(\"choices\").innerHTML=opts.map(o=>`<button type=\"button\" class=\"choice\" data-a=\"${o.id}\"><span>${esc(o.name)}</span><small>${esc(SYSTEMS[o.sys].name)}</small></button>`).join(\"\");\n  $(\"qfeed\").innerHTML=\"\"; $(\"qStudy\").hidden=true;\n  quizV.load(p); quizV.start();\n}\n$(\"choices\").addEventListener(\"click\",e=>{\n  const b=e.target.closest(\"[data-a]\"); if(!b||qDone) return;\n  qDone=true;\n  const ok=b.dataset.a===qAns.id;\n  document.querySelectorAll(\".choice\").forEach(c=>{c.disabled=true; if(c.dataset.a===qAns.id) c.classList.add(\"right\")});\n  if(!ok) b.classList.add(\"wrong\");\n  if(ok){qs.score++; qs.streak++; qs.best=Math.max(qs.best,qs.streak)} else qs.streak=0;\n  qScore();\n  const sys=SYSTEMS[qAns.sys];\n  const cheers=[\"Nailed it!\",\"Bucket!\",\"Money!\",\"That's a Bronco!\",\"Lights out!\"];\n  $(\"qfeed\").innerHTML=`<div class=\"feedback ${ok?\"good\":\"bad\"}\"><b>${ok?cheers[Math.floor(Math.random()*cheers.length)]:\"Not quite. It was \"+esc(qAns.name)}</b>${esc(sys.name)}. ${fmt(qAns.keys[0])}</div>`;\n  $(\"qStudy\").hidden=false;\n});\n$(\"qNext\").addEventListener(\"click\",newQuestion);\n$(\"qReplay\").addEventListener(\"click\",()=>{quizV.go(0); quizV.start()});\n$(\"qStudy\").addEventListener(\"click\",()=>nav(qAns.id));\n\n/* ---------- boot ---------- */\nbuildHome(); buildNav(); buildFilm(); buildQFilters(); qScore();\nheroLoad();\n// rotate the hero play every few loops\nsetInterval(()=>{if(route===\"home\"&&!reduce&&!document.hidden){heroIdx++; heroLoad(); hero.start()}},26000);\nrefreshProgress();\nhandle();\n})();\n</script>\n</body>\n</html>\n";
