gap:12px;margin-top:28px;flex-wrap:wrap}\n.playnav button{flex:1 1 240px;text-align:left;border:1px solid var(--line);background:var(--panel);border-radius:12px;padding:14px 16px;cursor:pointer}\n.playnav button:last-child{text-align:right}\n.playnav button:hover{border-color:var(--ink)}\n.playnav small{display:block;font-family:var(--cond);text-transform:uppercase;letter-spacing:.12em;color:var(--muted);font-size:13px;font-weight:700}\n.playnav b{font-family:var(--display);font-weight:800;text-transform:uppercase;font-size:24px}\n\n/* film room */\n.filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}\n.filter{font-family:var(--cond);font-weight:700;font-size:15px;letter-spacing:.06em;text-transform:uppercase;border:1px solid var(--line);background:var(--panel);border-radius:99px;padding:7px 14px;cursor:pointer}\n.filter:hover{border-color:var(--ink)}\n.filter[aria-pressed=\"true\"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}\n\n/* quiz */\n.quiz{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:24px;align-items:start;padding-block:10px 60px}\n.qpanel{background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow);padding:20px}\n.score{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:18px}\n.score div{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:10px 12px}\n.score b{display:block;font-family:var(--display);font-weight:800;font-size:34px;line-height:1;font-variant-numeric:tabular-nums}\n.score span{font-family:var(--cond);text-transform:uppercase;letter-spacing:.1em;font-size:12px;color:var(--muted);font-weight:700}\n.qq{font-family:var(--display);font-weight:800;text-transform:uppercase;font-size:30px;line-height:1;margin:0 0 14px}\n.choices{display:grid;gap:8px}\n.choice{display:flex;justify-content:space-between;align-items:center;gap:10px;text-align:left;border:2px solid var(--line);background:var(--panel);border-radius:10px;padding:12px 14px;cursor:pointer;font-size:17px;font-weight:600}\n.choice small{font-family:var(--cond);font-weight:600;text-transform:uppercase;letter-spacing:.08em;font-size:13px;color:var(--muted)}\n.choice:hover:not([disabled]){border-color:var(--ink)}\n.choice[disabled]{cursor:default}\n.choice.right{border-color:var(--good);background:var(--goodsoft)}\n.choice.wrong{border-color:var(--bad);background:var(--badsoft)}\n.feedback{margin-top:14px;padding:14px;border-radius:10px;font-size:16px}\n.feedback.good{background:var(--goodsoft)}\n.feedback.bad{background:var(--badsoft)}\n.feedback b{font-family:var(--cond);text-transform:uppercase;letter-spacing:.08em;font-size:18px;display:block}\n.qactions{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}\n.qbtn{display:inline-flex;align-items:center;gap:6px;border-radius:8px;padding:10px 16px;font-family:var(--cond);font-weight:700;font-size:16px;letter-spacing:.07em;text-transform:uppercase;cursor:pointer;border:2px solid var(--line);background:var(--panel)}\n.qbtn.red{background:var(--red);border-color:var(--red);color:#fff}\n.qbtn:hover{border-color:var(--ink)}\n.qbtn.red:hover{border-color:var(--red);filter:brightness(1.08)}\n\n.foot{border-top:1px solid var(--line);margin-top:40px;padding-block:22px;color:var(--muted);font-size:14px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px}\n\n/* svg court */\n.fl{fill:var(--court)} .pt{fill:var(--paint)}\n.ln{fill:none;stroke:var(--cline);stroke-width:2.2;stroke-linejoin:round}\n.ln.thin{stroke-width:2} .ln.dash{stroke-dasharray:6 6;opacity:.6}\n.rim{fill:none;stroke:var(--red);stroke-width:2.6}\n.lbltxt{font:600 13px \"Barlow Condensed\",sans-serif;letter-spacing:.14em;fill:var(--muted)}\n.ahp{fill:var(--arrow)} .ahx{fill:var(--xarrow)}\n.mv{fill:none;stroke:var(--arrow);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}\n.mv.pass{stroke-dasharray:7 5}\n.mv.x{stroke:var(--xarrow);stroke-width:1.6;opacity:.75}\n.of circle{fill:var(--ofill)} .of text{fill:var(--otext);font:700 15px \"Barlow Condensed\",sans-serif}\n.df path{stroke:var(--red);stroke-width:3.6;stroke-linecap:round;fill:none}\n.df text{fill:var(--red);font:700 12px \"Barlow Condensed\",sans-serif}\n.bl{fill:var(--ball);stroke:#7A3A0C;stroke-width:1.2}\n\n@media (max-width:1100px){.viewer{grid-template-columns:1fr}.steps ol{max-height:none}.hero-in{grid-template-columns:1fr}.hero-court{max-width:640px}.read{grid-template-columns:1fr}}\n@media (max-width:900px){.layout{grid-template-columns:1fr;gap:0}.side{display:none}.picker{display:block}.sides{grid-template-columns:1fr}.info{grid-template-columns:1fr}.quiz{grid-template-columns:1fr}.shortcuts{grid-template-columns:1fr}.pill{display:none}}\n@media (max-width:640px){.wrap{padding-inline:16px}.tab .tl{display:none}.tab{padding:9px 10px}.brand-name{font-size:19px}.keyline{grid-template-columns:1fr}.stat b{font-size:36px}}\n@media (max-width:520px){.btn .lbl{display:none}.btn.primary .lbl{display:inline}.cap p{font-size:16px}.brand-name{display:none}}\n@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}\n</style>\n</head>\n<body>\n\n<header class=\"bar\">\n  <div class=\"wrap bar-in\">\n    <a class=\"brand\" href=\"#home\" aria-label=\"MHS Secret Binder home\"><span class=\"brand-mark\">MHS</span><span class=\"brand-name\">Secret <span>Binder</span></span></a>\n    <nav class=\"tabs\" aria-label=\"Sections\">\n      <button class=\"tab\" data-go=\"home\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3 2 12h3v8h5v-6h4v6h5v-8h3z\"/></svg><span class=\"tl\">Home</span></button>\n      <button class=\"tab\" data-go=\"plays\"><svg viewBox=\"0 0 24 24\"><path d=\"M3 4h18v16H3zm2 2v12h6V6zm8 0v12h6V6zm-5 3a2 2 0 1 1 0 4 2 2 0 0 1 0-4z\"/></svg><span class=\"tl\">Plays</span></button>\n      <button class=\"tab\" data-go=\"film\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm6 4v6l5-3z\"/></svg><span class=\"tl\">Film Room</span></button>\n      <button class=\"tab\" data-go=\"quiz\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 16h-2v-2h2zm2.1-7.7-.9.9c-.7.7-1.2 1.3-1.2 2.8h-2v-.5c0-1.1.5-2.1 1.2-2.8l1.2-1.3a2 2 0 1 0-3.4-1.4H8a4 4 0 1 1 7.1 2.3z\"/></svg><span class=\"tl\">Quiz</span></button>\n      <a class=\"tab\" href=\"https://broncolifeskills.netlify.app\" target=\"_blank\" rel=\"noopener\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3 1 9l11 6 9-4.9V17h2V9zM5 13.2V17l7 4 7-4v-3.8L12 17z\"/></svg><span class=\"tl\">Life Skills</span></a>\n    </nav>\n    <div class=\"bar-tools\">\n      <span class=\"pill\" id=\"learnPill\"><b>0</b> of 0 learned</span>\n      <button class=\"iconbtn\" id=\"themeBtn\" title=\"Switch light or dark mode\" aria-label=\"Switch light or dark mode\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 3a9 9 0 1 0 9 9c0-.5 0-.9-.1-1.4A5.5 5.5 0 0 1 13.4 3.1 9 9 0 0 0 12 3z\"/></svg></button>\n    </div>\n  </div>\n</header>\n\n<!-- HOME -->\n<main id=\"v-home\" class=\"view\">\n  <section class=\"hero\">\n    <div class=\"wrap hero-in\">\n      <div>\n        <div class=\"eyebrow\">Middleburg Lady Broncos Girls Basketball</div>\n        <h1>MHS <span>Secret Binder</span></h1>\n        <p class=\"lede\">Every offense and defense we run, drawn on the court. Pick a set, press play, and watch each cut, pass, and screen one step at a time. Then watch the film and test yourself.</p>\n        <div class=\"cta\">\n          <button class=\"big red\" id=\"startBtn\"><svg viewBox=\"0 0 24 24\"><path d=\"M8 5v14l11-7z\"/></svg><span id=\"startLbl\">Start learning</span></button>\n          <button class=\"big ghost\" data-go=\"quiz\">Take the quiz</button>\n        </div>\n        <div class=\"stats\">\n          <div class=\"stat\"><b id=\"sPlays\">0</b><span>Plays</span></div>\n          <div class=\"stat\"><b id=\"sSystems\">0</b><span>Systems</span></div>\n          <div class=\"stat\"><b id=\"sVids\">0</b><span>Film clips</span></div>\n        </div>\n      </div>\n      <div class=\"hero-court dark-court\">\n        <div class=\"court-wrap\"><svg class=\"court\" id=\"heroCourt\" role=\"img\" aria-label=\"Animated preview of a play\"></svg></div>\n        <div class=\"hero-cap\"><span>Now running: <b id=\"heroName\"></b></span><button id=\"heroOpen\">Open play</button></div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section wrap\">\n    <h2>Pick your side</h2>\n    <p class=\"sub\">Tap a system to open its first play, or jump straight to any play. Green means you marked it learned.</p>\n    <div class=\"sides\" id=\"sides\"></div>\n  </section>\n\n  <section class=\"section wrap\">\n    <h2>How to read the court</h2>\n    <p class=\"sub\">Every diagram and every sentence uses the same numbers, so what you read always matches what you see.</p>\n    <div class=\"read\">\n      <div class=\"card\">\n        <h3>The numbers</h3>\n        <div class=\"numrow\" aria-label=\"Our players\">\n          <div><span class=\"pn\">1</span>Player 1</div><div><span class=\"pn\">2</span>Player 2</div><div><span class=\"pn\">3</span>Player 3</div><div><span class=\"pn\">4</span>Player 4</div><div><span class=\"pn\">5</span>Player 5</div>\n        </div>\n        <div class=\"numrow\" aria-label=\"Defensive players\">\n          <div><span class=\"dn\">1</span>Defensive player 1</div><div><span class=\"dn\">2</span>Defensive player 2</div><div><span class=\"dn\">3</span>Defensive player 3</div><div><span class=\"dn\">4</span>Defensive player 4</div><div><span class=\"dn\">5</span>Defensive player 5</div>\n        </div>\n        <p class=\"tipbox\">Dark circles are the offense: players 1 through 5. Red X marks are the defense: defensive players 1 through 5. When our defense runs man, defensive player 1 guards player 1, defensive player 2 guards player 2, and so on.</p>\n      </div>\n      <div class=\"card\">\n        <h3>The lines</h3>\n        <div class=\"keyline\">\n          <span><svg viewBox=\"0 0 46 18\"><path d=\"M2 9h34\" stroke=\"var(--arrow)\" stroke-width=\"2.2\" fill=\"none\"/><path d=\"M34 4l9 5-9 5z\" fill=\"var(--arrow)\"/></svg>Cut: a player runs without the ball</span>\n          <span><svg viewBox=\"0 0 46 18\"><path d=\"M2 9l3-5 4 10 4-10 4 10 4-10 4 10 4-10 3 5h4\" stroke=\"var(--arrow)\" stroke-width=\"2\" fill=\"none\"/><path d=\"M34 4l9 5-9 5z\" fill=\"var(--arrow)\"/></svg>Dribble: a player moves with the ball</span>\n          <span><svg viewBox=\"0 0 46 18\"><path d=\"M2 9h34\" stroke=\"var(--arrow)\" stroke-width=\"2.2\" stroke-dasharray=\"6 4\" fill=\"none\"/><path d=\"M34 4l9 5-9 5z\" fill=\"var(--arrow)\"/></svg>Pass: the ball moves between players</span>\n          <span><svg viewBox=\"0 0 46 18\"><path d=\"M2 9h36M38 2v14\" stroke=\"var(--arrow)\" stroke-width=\"2.6\" fill=\"none\"/></svg>Screen: a player sets a pick</span>\n          <span><svg viewBox=\"0 0 46 18\"><path d=\"M2 9h34\" stroke=\"var(--xarrow)\" stroke-width=\"1.8\" fill=\"none\" opacity=\".8\"/><path d=\"M34 4l9 5-9 5z\" fill=\"var(--xarrow)\"/></svg>Defensive movement</span>\n          <span><svg viewBox=\"0 0 46 18\"><circle cx=\"12\" cy=\"9\" r=\"6.5\" fill=\"var(--ball)\" stroke=\"#7A3A0C\" stroke-width=\"1.2\"/></svg>The ball</span>\n        </div>\n        <p class=\"tipbox\">On any play: Space plays or pauses, the right arrow goes forward one step, and the left arrow goes back.</p>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section wrap\">\n    <div class=\"shortcuts\">\n      <button class=\"shortcut\" data-go=\"plays\"><b>Study a play</b><span>Animated court, step by step breakdown, keys, and film for all of our sets.</span><span class=\"go\">Open the plays</span></button>\n      <button class=\"shortcut\" data-go=\"film\"><b>Film Room</b><span>Every clip in one place. Filter by system and watch right here on the page.</span><span class=\"go\">Watch film</span></button>\n      <button class=\"shortcut\" data-go=\"quiz\"><b>Name that play</b><span>Watch a play run with no words and pick its name. Build your streak.</span><span class=\"go\">Start the quiz</span></button>\n    </div>\n  </section>\n  <footer class=\"wrap foot\"><span>MHS Secret Binder · Middleburg Lady Broncos Girls Basketball</span><span>Know the play. Run the play. Win the play.</span></footer>\n</main>\n\n<!-- PLAY -->\n<main id=\"v-play\" class=\"view\" hidden>\n  <div class=\"wrap layout\">\n    <nav class=\"side\" id=\"side\" aria-label=\"Plays\"></nav>\n    <div>\n      <div class=\"picker\"><label for=\"pick\">Choose a play</label><select id=\"pick\"></select></div>\n      <section>\n        <div class=\"eyebrow\" id=\"eyebrow\"></div>\n        <div class=\"ph\">\n          <h1 id=\"title\"></h1>\n          <button class=\"learn\" id=\"learnBtn\" aria-pressed=\"false\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z\"/></svg><span id=\"learnLbl\">Mark as learned</span></button>\n        </div>\n        <div class=\"chips\" id=\"chips\"></div>\n        <p class=\"setup\" id=\"setup\"></p>\n      </section>\n\n      <div class=\"viewer\">\n        <div class=\"stage\" id=\"stage\">\n          <div class=\"court-wrap\"><svg class=\"court\" id=\"court\" role=\"img\" aria-label=\"Animated play diagram\"></svg></div>\n          <div class=\"prog\"><i id=\"bar\"></i></div>\n          <div class=\"cap\" aria-live=\"polite\"><div class=\"k\" id=\"capk\"></div><p id=\"capt\"></p></div>\n          <div class=\"ctl\">\n            <button class=\"btn\" id=\"bRestart\" title=\"Restart\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 5V2L7 6l5 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z\"/></svg><span class=\"lbl\">Restart</span></button>\n            <button class=\"btn\" id=\"bPrev\" title=\"Back one step\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 6h2v12H6zM9.5 12 18 18V6z\"/></svg><span class=\"lbl\">Back</span></button>\n            <button class=\"btn primary\" id=\"bPlay\"><svg viewBox=\"0 0 24 24\" id=\"playIcon\"><path d=\"M8 5v14l11-7z\"/></svg><span class=\"lbl\" id=\"playLbl\">Play</span></button>\n            <button class=\"btn\" id=\"bNext\" title=\"Next step\"><svg viewBox=\"0 0 24 24\"><path d=\"M16 6h2v12h-2zM6 18l8.5-6L6 6z\"/></svg><span class=\"lbl\">Next</span></button>\n            <button class=\"btn sp\" id=\"bSpeed\" title=\"Change speed\"><span id=\"spd\">1x</span></button>\n          </div>\n          <div class=\"legend\">\n            <span><svg viewBox=\"0 0 34 16\"><circle cx=\"8\" cy=\"8\" r=\"7\" fill=\"var(--ofill)\"/><text x=\"8\" y=\"11.5\" text-anchor=\"middle\" font-size=\"10\" font-weight=\"700\" fill=\"var(--otext)\" font-family=\"Barlow Condensed,sans-serif\">1</text></svg>Player</span>\n            <span><svg viewBox=\"0 0 34 16\"><path d=\"M3 3l10 10M13 3 3 13\" stroke=\"var(--red)\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>Defensive player</span>\n            <span><svg viewBox=\"0 0 34 16\"><path d=\"M2 8h24\" stroke=\"var(--arrow)\" stroke-width=\"2\"/><path d=\"M24 4l7 4-7 4z\" fill=\"var(--arrow)\"/></svg>Cut</span>\n            <span><svg viewBox=\"0 0 34 16\"><path d=\"M2 8l3-4 4 8 4-8 4 8 4-8 3 4h4\" stroke=\"var(--arrow)\" stroke-width=\"2\" fill=\"none\"/><path d=\"M26 4l7 4-7 4z\" fill=\"var(--arrow)\"/></svg>Dribble</span>\n            <span><svg viewBox=\"0 0 34 16\"><path d=\"M2 8h24\" stroke=\"var(--arrow)\" stroke-width=\"2\" stroke-dasharray=\"4 3\"/><path d=\"M24 4l7 4-7 4z\" fill=\"var(--arrow)\"/></svg>Pass</span>\n            <span><svg viewBox=\"0 0 34 16\"><path d=\"M2 8h26M28 2v12\" stroke=\"var(--arrow)\" stroke-width=\"2.5\"/></svg>Screen</span>\n          </div>\n        </div>\n        <aside class=\"steps\">\n          <h3><span>Step by step</span><span id=\"stepCount\"></span></h3>\n          <ol id=\"stepList\"></ol>\n        </aside>\n      </div>\n\n      <section class=\"block\">\n        <div class=\"block-h\"><h2>Watch the film</h2><p id=\"filmNote\"></p></div>\n        <div class=\"vgrid\" id=\"playVids\"></div>\n      </section>\n\n      <div class=\"info\">\n        <div class=\"card\"><h3>Keys to run it</h3><ul id=\"keys\"></ul></div>\n        <div class=\"card rules\" id=\"sysrules\"></div>\n      </div>\n\n      <div class=\"playnav\" id=\"playnav\"></div>\n    </div>\n  </div>\n</main>\n\n<!-- FILM -->\n<main id=\"v-film\" class=\"view\" hidden>\n  <section class=\"section wrap\">\n    <div class=\"eyebrow\">Film Room</div>\n    <h2>Watch it done right</h2>\n    <p class=\"sub\">Every clip in the binder, playing right here on the page. Our play names are our own, so the clips may call things by different names. Tap a tag to open the play it teaches.</p>\n    <div class=\"filters\" id=\"filters\"></div>\n    <div class=\"vgrid\" id=\"filmGrid\"></div>\n  </section>\n  <footer class=\"wrap foot\"><span>MHS Secret Binder · Middleburg Lady Broncos Girls Basketball</span><span>Know the play. Run the play. Win the play.</span></footer>\n</main>\n\n<!-- QUIZ -->\n<main id=\"v-quiz\" class=\"view\" hidden>\n  <section class=\"section wrap\" style=\"padding-bottom:0\">\n    <div class=\"eyebrow\">Quiz</div>\n    <h2>Name that play</h2>\n    <p class=\"sub\">Watch the play run with no words, then pick its name. Replay it as many times as you need.</p>\n    <div class=\"filters\" id=\"qfilters\"></div>\n  </section>\n  <div class=\"wrap quiz\">\n    <div class=\"stage\" id=\"qstage\">\n      <div class=\"court-wrap\"><svg class=\"court\" id=\"qcourt\" role=\"img\" aria-label=\"Quiz play diagram\"></svg></div>\n      <div class=\"prog\"><i id=\"qbar\"></i></div>\n      <div class=\"ctl\">\n        <button class=\"btn primary\" id=\"qReplay\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 5V2L7 6l5 4V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z\"/></svg><span class=\"lbl\">Replay</span></button>\n        <span class=\"k\" id=\"qstep\" style=\"font-family:var(--cond);text-transform:uppercase;letter-spacing:.1em;color:var(--muted);font-size:14px\"></span>\n      </div>\n    </div>\n    <div class=\"qpanel\">\n      <div class=\"score\">\n        <div><b id=\"qScore\">0</b><span>Correct</span></div>\n        <div><b id=\"qStreak\">0</b><span>Streak</span></div>\n        <div><b id=\"qBest\">0</b><span>Best streak</span></div>\n      </div>\n      <p class=\"qq\">Which play is this?</p>\n      <div class=\"choices\" id=\"choices\"></div>\n      <div id=\"qfeed\"></div>\n      <div class=\"qactions\">\n        <button class=\"qbtn red\" id=\"qNext\">Next play</button>\n        <button class=\"qbtn\" id=\"qStudy\" hidden>Study this play</button>\n      </div>\n    </div>\n  </div>\n</main>\n\n<script>\n(function(){\n\"use strict\";\n/* ---------- geometry ---------- */\nconst RIM=[250,78];\nconst sub=(a,b)=>[a[0]-b[0],a[1]-b[1]], add=(a,b)=>[a[0]+b[0],a[1]+b[1]], mul=(a,k)=>[a[0]*k,a[1]*k];\nconst len=a=>Math.hypot(a[0],a[1]), unit=a=>{const l=len(a)||1;return[a[0]/l,a[1]/l]};\nconst dist=(a,b)=>len(sub(a,b));\nconst rot=(v,t)=>[v[0]*Math.cos(t)-v[1]*Math.sin(t),v[0]*Math.sin(t)+v[1]*Math.cos(t)];\n\n/* ---------- defense logic ---------- */\nconst ZONES={\n  \"23\":{base:[[200,245],[300,245],[120,125],[380,125],[250,110]],kx:[.35,.35,.22,.22,.35],ky:[.15,.15,.08,.08,.05]},\n  \"131\":{base:[[250,330],[95,215],[405,215],[250,200],[250,95]],kx:[.4,.15,.15,.3,.55],ky:[.2,.1,.1,.1,.02],trap:true},\n  \"122\":{base:[[250,330],[180,250],[320,250],[165,110],[335,110]],kx:[.4,.3,.3,.25,.25],ky:[.2,.15,.15,.05,.05],trap:true},\n  \"32\":{base:[[250,305],[110,245],[390,245],[185,115],[315,115]],kx:[.3,.2,.2,.3,.3],ky:[.15,.1,.1,.05,.05]},\n  \"tri\":{base:[[250,210],[180,105],[320,105]],kx:[.3,.25,.25],ky:[.1,.05,.05]},\n  \"box\":{base:[[190,220],[310,220],[180,105],[320,105]],kx:[.3,.3,.25,.25],ky:[.12,.12,.05,.05]},\n  \"circle\":{base:[[250,268],[140,205],[360,205],[160,100],[340,100]],kx:[.25,.2,.2,.2,.2],ky:[.1,.08,.08,.04,.04]}\n};\nfunction zoneCalc(z,B){\n  const pts=z.base.map((b,i)=>[b[0]+(B[0]-250)*z.kx[i],b[1]+(B[1]-230)*z.ky[i]]);\n  const order=pts.map((p,i)=>[dist(p,B),i]).sort((a,b)=>a[0]-b[0]).map(a=>a[1]);\n  if(z.trap&&Math.abs(B[0]-250)>110&&B[1]<300){\n    const u=unit(sub(RIM,B));\n    pts[order[0]]=add(B,mul(rot(u,.75),28));\n    pts[order[1]]=add(B,mul(rot(u,-.75),28));\n  }else{\n    pts[order[0]]=add(B,mul(unit(sub(RIM,B)),26));\n  }\n  return pts;\n}\nfunction manSpot(O,B,mode,isBall){\n  if(mode===\"boxout\") return add(O,mul(unit(sub(RIM,O)),20));\n  if(isBall) return add(O,mul(unit(sub(RIM,O)),mode===\"deny\"?17:24));\n  if(mode===\"deny\") return add(add(O,mul(unit(sub(B,O)),16)),mul(unit(sub(RIM,O)),6));\n  return add(O,add(mul(sub(RIM,O),.22),mul(sub(B,O),.22)));\n}\nfunction defCalc(dm,P,ball,play){\n  const X={}, B=P[ball];\n  if(!B||dm===\"none\") return X;\n  if(dm===\"man\"||dm===\"deny\"||dm===\"boxout\"){\n    for(let i=1;i<=5;i++){const o=P[\"o\"+i]; if(o) X[\"x\"+i]=manSpot(o,B,dm,ball===\"o\"+i);}\n    return X;\n  }\n  if(dm===\"fdeny\"){\n    for(let i=1;i<=5;i++){const o=P[\"o\"+i]; if(!o) continue;\n      X[\"x\"+i]= ball===\"o\"+i ? [o[0],o[1]-24] : add(o,mul(unit(sub(B,o)),15));}\n    return X;\n  }\n  if(dm===\"tri\"||dm===\"box\"){\n    const t=play.targets, zid=dm===\"tri\"?[\"x3\",\"x4\",\"x5\"]:[\"x2\",\"x3\",\"x4\",\"x5\"];\n    t.forEach((id,k)=>{X[\"x\"+(k+1)]=manSpot(P[id],B,\"deny\",ball===id)});\n    const pts=zoneCalc(ZONES[dm],B); zid.forEach((id,k)=>X[id]=pts[k]);\n    return X;\n  }\n  if(ZONES[dm]){zoneCalc(ZONES[dm],B).forEach((p,k)=>X[\"x\"+(k+1)]=p);}\n  return X;\n}\n\nconst DEF_RULES=[\"Talk early, talk loud. Call ball, help, screens, cutters, and loose balls. If you are not talking, you are not playing defense.\",\"Protect the paint first. Deny straight line drives and make them take contested jumpers.\",\"Sprint to help, fly to contest. Help side crosses the key line before the ball moves. High hands on closeouts, no fouls.\",\"Finish every play. Physical box out and a secure two hand rebound.\"];\nconst SYSTEMS={\n  flow:{side:\"Offense\",name:\"FLOW\",sub:\"Ball screen continuity\",rules:[\"Pace and patience. Screeners sprint into screens. Ball handlers wait for the screen to be set before attacking.\",\"Empty corners. Keep the corner on the ball screen side clear so there is no help defender there.\",\"High low reads. Slot catchers read switches right away and throw the lob over fronting defenders. Timing is essential.\",\"Lift from the corners. Never catch the ball in the corner.\",\"Make eye contact with the ball handler before sealing.\",\"Cut with a purpose.\"],vids:[[\"wj74RMHfu9Q\", \"Ball screen continuity\"], [\"0xvqFBmsYeo\", \"Ball screen scoring options\"], [\"CXSVg_-J11w\", \"Ball screen continuity: BYU and the Bulls\"]]},\n  princeton:{side:\"Offense\",name:\"Princeton Point\",sub:\"Point Series\",rules:[\"High elbow spacing. {5} lifts one step outside and above the elbow so backdoor cutters have room.\",\"Sell the cuts. Every cut has to look like a scoring cut or the defense will not overplay into the backdoor.\",\"Patience at the elbow. {5} pivots, keeps the ball high, and reads the defender before choosing backdoor, handoff, or screen.\"],vids:[[\"n59Z36O9AGI\", \"Point Away: San Francisco Dons\"], [\"W0j-fXxsIq0\", \"Point Away and Point Over: Nebraska Wesleyan\"], [\"TFS37TrZHO8\", \"Air Force Princeton breakdown: Point and Chin\"]]},\n  z41:{side:\"Offense\",name:\"41 Zone Offense\",sub:\"4 Out sets vs zone\",rules:[\"Patience over fast shots. At least two or three passes before a shot to pull the zone out of position.\",\"Pass fake and catch. Crisp fakes freeze zone defenders before the entry to the post or corner.\",\"Target the gaps. Attack the seams with purpose, draw two defenders, then kick or dump it off.\",\"Baseline spacing. The post holds the short corner 12 to 15 feet out so corner shooters have room.\",\"Cut with a purpose.\"],vids:[[\"oM61VCHxuCc\", \"4 Out offense vs the 2 3 zone\"], [\"TYSBWUAR0qE\", \"3 plays to beat the 2 3 zone\"], [\"y-lJndxcsow\", \"High low offense vs the 2 3 zone\"]]},\n  man:{side:\"Defense\",name:\"Man Defenses\",sub:\"Shadow, Dark, Blackout\",rules:DEF_RULES,vids:[[\"vh96pvvzODk\", \"Man to man defense fundamentals\"]]},\n  zone:{side:\"Defense\",name:\"Zone Defenses\",sub:\"Numbers system\",rules:DEF_RULES,vids:[]},\n  spec:{side:\"Defense\",name:\"Specialty Defenses\",sub:\"Shapes system\",rules:DEF_RULES,vids:[]},\n  press:{side:\"Defense\",name:\"Full Court Press\",sub:\"Press defenses\",rules:DEF_RULES,vids:[]}\n};\n\n/* ---------- plays ---------- */\nconst PB={o1:[175,290],o2:[325,290],o3:[75,205],o4:[425,205],o5:[155,100]};\nconst PEND={o1:[462,50],o2:[290,300],o3:[38,50],o4:[425,205],o5:[165,240]};\nconst OFF={o1:[250,300],o2:[425,205],o3:[75,205],o4:[462,50],o5:[155,100]};\nconst OFF2={o1:[200,300],o2:[300,300],o3:[75,205],o4:[425,205],o5:[155,100]};\nconst FULL0={o1:[300,945],o2:[140,850],o3:[360,830],o4:[250,620],o5:[250,330]};\n\nconst PLAYS=[\n/* FLOW */\n{id:\"flow\",sys:\"flow\",name:\"Entry and Continuity\",target:\"Man to man\",look:\"Empty side ball screen, roll, and swing\",\n keys:[\"Wings run wide and deep to the corners in transition to stretch the defense.\",\"{5} runs the rim first, then shakes up to the block.\",\"Screeners sprint into the screen. The ball handler waits for it to be set.\",\"After every roll, somebody lifts to the slot to catch the kick out.\",\"The cutter goes hard to the basket first, then all the way through to the opposite corner.\",\"When the cutter fills the corner, the wing and corner players rotate up along the 3 point line.\",\"Each phase ends with a swing and a new empty side ball screen, so the action never stops.\"],\n steps:[\n {o:{o1:[350,295],o2:[462,50],o3:[38,50],o4:[150,295],o5:[345,100]},ball:\"o1\",t:\"4 Out setup. {1} has the ball in the slot. {4}, the trail big, fills the other slot. {2} and {3} sprint wide to the corners and {5} runs the rim, then shakes up to the block.\"},\n {o:{o1:[425,205]},ball:\"o4\",pass:\"start\",tag:\"Entry\",t:\"{1} reverses the ball to {4} in the other slot, then drifts down to the wing.\"},\n {o:{o3:[75,205]},ball:\"o3\",tag:\"Entry\",t:\"{3} lifts from the corner to the wing (never catch it in the corner) and {4} swings the ball to {3}.\"},\n {o:{o4:[112,232]},scr:[\"o4\"],tag:\"Entry\",t:\"{4} follows the pass into an empty wing ball screen for {3}. Nobody sits in the corner behind it.\"},\n {o:{o3:[205,170],o4:[215,95],o5:[350,295]},via:{o3:[[150,215]]},tag:\"Phase 1\",t:\"{3} waits for the screen, then drives off it. {4} rolls hard to the rim. {5} lifts to the weak side slot to clear the lane for the roll.\"},\n {ball:\"o5\",tag:\"Phase 1\",t:\"{3} kicks the ball out to {5} in the slot.\"},\n {o:{o1:[250,105],o2:[425,205],o3:[75,205],o4:[38,50]},via:{o1:[[330,160]]},tag:\"Phase 2\",t:\"{1} cuts hard from the wing to the basket. {2} lifts from the corner to fill the wing. {4} steps out to the weak side corner and {3} spaces back to the wing.\"},\n {o:{o1:[38,50],o4:[75,205],o3:[250,315]},via:{o1:[[150,70]],o4:[[48,130]],o3:[[150,285]]},tag:\"Phase 2\",t:\"{1} continues through to the opposite corner. As she gets there, {3} and {4} rotate up along the 3 point line: {3} to the top of the key and {4} to the wing. {1} stays in the corner.\"},\n {ball:\"o2\",tag:\"Phase 3\",t:\"{5} passes to {2} on the wing.\"},\n {o:{o5:[388,228]},scr:[\"o5\"],tag:\"Phase 3\",t:\"{5} follows the pass into a ball screen for {2}.\"},\n {o:{o2:[300,170],o5:[300,95]},via:{o2:[[350,215]]},tag:\"Phase 3\",t:\"{2} attacks the middle off the screen while {5} rolls to the rim.\"},\n {ball:\"o3\",tag:\"Phase 4\",t:\"{2} passes out to {3} at the top of the key.\"},\n {o:{o5:[345,100],o2:[425,205],o4:[462,50]},via:{o4:[[170,125],[250,112],[390,75]]},tag:\"Phase 4\",t:\"{5} clears out of the lane and {2} spaces back out to the wing. {4} cuts from the wing to the basket, then continues through to the opposite corner.\"},\n {o:{o1:[75,205]},ball:\"o1\",tag:\"Phase 4\",t:\"{1} lifts from the corner to the wing and {3} passes her the ball.\"},\n {o:{o3:[112,232]},scr:[\"o3\"],tag:\"Phase 4\",t:\"{3} follows the pass into a ball screen for {1}.\"},\n {o:{o1:[205,170],o3:[215,95]},via:{o1:[[150,215]]},tag:\"Phase 4\",t:\"{1} attacks off the ball screen and {3} rolls hard to the basket.\"}\n ]},\n{id:\"flow_highlow\",sys:\"flow\",name:\"High Low Read\",target:\"Switches or under\",look:\"Lob from the slot to the rolling post\",\n keys:[\"Read the switch as soon as you catch in the slot.\",\"The roller seals the smaller defender and shows a high target with one hand.\",\"Throw it high and to the rim side, where only your teammate can catch it.\",\"If they front, the lob is there. If they play behind, the roller posts and catches low.\"],\n steps:[\n {o:{o1:[425,205],o2:[462,50],o3:[205,170],o4:[215,95],o5:[350,295]},ball:\"o3\",t:\"Start from Phase 1. {3} is driving off the wing ball screen and {4} is rolling to the rim.\"},\n {o:{o3:[75,205]},ball:\"o5\",pass:\"start\",t:\"{3} kicks the ball out to {5} in the slot and spaces back to the wing.\"},\n {o:{o4:[235,122]},t:\"The defense switched or went under, so {4} seals the smaller defender in the lane and shows a high target.\"},\n {ball:\"o4\",t:\"{5} reads it right away and throws the high low pass over the top.\"},\n {shot:true,t:\"{4} finishes at the rim.\"}\n ]},\n/* PRINCETON */\n{id:\"point_entry_a\",sys:\"princeton\",name:\"Entry A: Slot Reversal\",target:\"Man to man\",look:\"Get the ball to {5} at the high elbow\",\n keys:[\"Guards start in the slots, lane line extended.\",\"The shallow cut goes through the paint, not around it.\",\"{5} lifts one step outside and above the elbow.\",\"Once {5} catches, the passer triggers Over or Away.\"],\n steps:[\n {o:PB,ball:\"o1\",t:\"Setup: {1} and {2} in the slots, {3} and {4} on the wings, {5} on the ball side block.\"},\n {ball:\"o2\",t:\"{1} reverses the ball to {2} in the other slot.\"},\n {o:{o1:[462,50],o5:[165,240],o3:[38,50]},via:{o1:[[250,185]]},t:\"{1} makes a shallow cut through the paint to the far corner. {5} lifts to the high elbow, one step above and outside it. {3} sinks to the corner.\"},\n {o:{o2:[290,300]},ball:\"o5\",t:\"{2} takes one or two dribbles toward the middle and hits {5} at the high elbow. Now {2} chooses Over or Away.\"}\n ]},\n{id:\"point_entry_b\",sys:\"princeton\",name:\"Entry B: Wave Through\",target:\"Man to man\",look:\"Get the ball to {5} at the high elbow\",\n keys:[\"{1} dribbles at {2} and waves her through.\",\"{2}'s shallow cut clears the slot for the dribbler.\",\"{5} lifts to the elbow on the other side of the floor.\",\"{1} makes the entry and immediately triggers the action.\"],\n steps:[\n {o:PB,ball:\"o1\",t:\"Setup: {1} and {2} in the slots, {3} and {4} on the wings, {5} on the block.\"},\n {o:{o1:[290,295],o2:[38,50]},via:{o2:[[250,185]]},t:\"{1} dribbles toward {2} and waves her through. {2} makes a shallow cut across the key to the far corner.\"},\n {o:{o5:[165,240]},t:\"{5} lifts to the high elbow on the other side of the floor.\"},\n {ball:\"o5\",t:\"{1} hits {5} at the high elbow and triggers Over or Away.\"}\n ]},\n{id:\"point_over\",vids:[[\"W0j-fXxsIq0\", \"Point Away and Point Over: Nebraska Wesleyan\"]],sys:\"princeton\",name:\"Point Over\",target:\"Man to man\",look:\"Zoom into a handoff, drive, and roll\",\n keys:[\"The passer cuts over the top of {5}, not behind.\",\"Pin down, then zoom: {3} sprints right at {5} for the handoff.\",\"{5} rolls hard the moment the ball leaves her hands.\",\"{2} shakes up to the wing after screening to pull the help away.\"],\n steps:[\n {o:PEND,ball:\"o5\",t:\"Start: {5} has the ball at the high elbow. {2} just made the entry pass.\"},\n {o:{o2:[62,98]},via:{o2:[[140,275]]},scr:[\"o2\"],t:\"{2} cuts over the top of {5} toward the corner and sets a pin down screen for {3}.\"},\n {o:{o3:[140,255]},via:{o3:[[95,160]]},t:\"{3} comes off the pin down (zoom action) and sprints right at {5} for the handoff.\"},\n {ball:\"o3\",t:\"{5} hands the ball off to {3}.\"},\n {o:{o3:[225,150],o5:[240,95],o2:[75,205]},t:\"{3} attacks downhill. {5} rolls hard to the rim. {2} shakes up to the wing to pull the help defender away.\"},\n {ball:\"o5\",t:\"The help steps up to {3}, so {3} drops it to {5} on the roll.\"},\n {shot:true,t:\"{5} finishes at the rim.\"}\n ]},\n{id:\"point_over_back\",vids:[[\"W0j-fXxsIq0\", \"Point Away and Point Over: Nebraska Wesleyan\"]],sys:\"princeton\",name:\"Point Over: Backdoor Read\",target:\"Man to man\",look:\"Backdoor layup when the defender cheats the screen\",\n keys:[\"{3} reads her defender. If she cheats over the screen, reject it and go.\",\"{5} keeps the ball high and pivots to see the cut.\",\"Use a bounce pass to the backdoor cutter.\",\"If the backdoor is covered, {3} keeps going to the weak side and {2} pops out for a pass and follow ball screen from {5}.\"],\n steps:[\n {o:PEND,ball:\"o5\",t:\"Start: {5} has the ball at the high elbow.\"},\n {o:{o2:[62,98]},via:{o2:[[140,275]]},scr:[\"o2\"],t:\"{2} cuts over the top of {5} and sets the pin down for {3}.\"},\n {o:{o3:[225,100]},via:{o3:[[120,70]]},t:\"{3}'s defender cheats over the screen, so {3} rejects it and cuts backdoor to the rim.\"},\n {ball:\"o3\",t:\"{5} pivots, keeps the ball high, and delivers the bounce pass.\"},\n {shot:true,t:\"{3} finishes the layup.\"}\n ]},\n{id:\"point_away\",vids:[[\"n59Z36O9AGI\", \"Point Away: San Francisco Dons\"], [\"W0j-fXxsIq0\", \"Point Away and Point Over: Nebraska Wesleyan\"]],sys:\"princeton\",name:\"Point Away\",target:\"Man to man\",look:\"Backdoor cut, then pass and follow ball screen\",\n keys:[\"The passer screens away for the next closest perimeter player.\",\"The cutter usually rejects the screen and goes backdoor.\",\"If it is covered, clear to the corner and flow right into the ball screen.\",\"{1} lifts from the corner to the wing to keep the tag defender busy.\"],\n steps:[\n {o:PEND,ball:\"o5\",t:\"Start: {5} has the ball at the high elbow. {2} just made the entry pass.\"},\n {o:{o2:[392,228]},scr:[\"o2\"],t:\"{2} cuts away from {5} and sets an away screen for {4}.\"},\n {o:{o4:[275,100]},via:{o4:[[380,140]]},t:\"{4} reads the screen, rejects it, and cuts hard backdoor looking for the pass from {5}.\"},\n {o:{o4:[462,50],o1:[425,205],o2:[325,290]},t:\"{4} is covered, so she clears to the corner. {1} shakes up to the wing and {2} pops back out to the perimeter.\"},\n {ball:\"o2\",t:\"{5} passes to {2}.\"},\n {o:{o5:[292,262]},scr:[\"o5\"],t:\"{5} follows the pass into a ball screen for {2}.\"},\n {o:{o2:[235,170],o5:[275,95]},via:{o2:[[270,245]]},t:\"{2} attacks off the ball screen as {5} rolls. {1} on the wing occupies the tag defender.\"}\n ]},\n{id:\"forwards_out\",sys:\"princeton\",name:\"Forwards Out\",target:\"Man to man\",look:\"Swap guards and forwards to create mismatches\",\n keys:[\"Keeps the defense from keying on fixed positions.\",\"Gets guards into the post and pulls forwards to the top.\",\"Can also be triggered with a slot to wing handoff.\"],\n steps:[\n {o:PB,ball:\"o1\",t:\"Setup: guards in the slots, forwards on the wings, {5} on the block.\"},\n {ball:\"o3\",t:\"{1} passes to {3} on the wing.\"},\n {o:{o1:[38,50],o2:[425,205],o4:[325,290]},via:{o1:[[150,190]]},t:\"{1} cuts to the corner while {2} and {4} exchange on the weak side. A forward is now up top.\"},\n {o:{o5:[165,240]},t:\"{5} lifts to the high elbow.\"},\n {ball:\"o5\",t:\"{3} hits {5} at the elbow and the Point Series runs with the forwards in the guard spots.\"}\n ]},\n/* 41 ZONE */\n{id:\"river\",vids:[[\"VnyuAhFZSXM\", \"4 Flash offense vs the 2 3 zone: Michigan\"]],sys:\"z41\",name:\"River\",target:\"1 2 2 or 2 3 zone\",look:\"High post flash jumper or weak side block layup\",def:\"23\",\n keys:[\"Start in true 4 Out spacing: guards wide in the slots, {3} and {4} deep in the corners.\",\"{1} attacks the gap to make two defenders commit.\",\"{5} slides ball side when the low defender steps out.\",\"On every return pass, the weak side player flashes into the paint.\",\"Flash, slip, and repeat. The high low is always there.\"],\n steps:[\n {o:{o1:[150,295],o2:[350,295],o3:[462,50],o4:[38,50],o5:[345,100]},ball:\"o1\",t:\"Setup: 4 Out, 1 In. {1} and {2} wide in the slots, {3} and {4} deep in the corners, {5} on the weak side block.\"},\n {o:{o1:[215,262],o5:[250,150],o3:[425,82]},t:\"{1} dribbles directly at the gap between the top two defenders to make both commit. {5} flashes into the middle of the paint and {3} creeps from the corner toward the weak side block.\"},\n {o:{o1:[150,295],o4:[75,205],o5:[160,100]},ball:\"o4\",t:\"{1} dribbles back out and hits {4} as she lifts from the corner to the wing. As the low defender steps out, {5} slides to the ball side block and posts up.\"},\n {ball:\"o1\",t:\"Nothing inside, so {4} passes back out to {1}.\"},\n {o:{o3:[255,165],o5:[345,100]},t:\"As the ball comes back, {3} flashes hard into the middle of the paint and {5} slips to the weak side block.\"},\n {ball:\"o3\",t:\"{1} hits {3} in the paint. The lob to {5} over the middle defender is also there.\"},\n {ball:\"o5\",t:\"High low: {3} can shoot, or drop it to {5} on the opposite block.\"},\n {shot:true,t:\"{5} finishes at the rim.\"}\n ]},\n{id:\"river_cont\",vids:[[\"VnyuAhFZSXM\", \"4 Flash offense vs the 2 3 zone: Michigan\"]],sys:\"z41\",name:\"River Continuity\",target:\"1 2 2 or 2 3 zone\",look:\"Keep flashing until the zone breaks\",def:\"23\",\n keys:[\"If the flash is denied, clear back out to the corner so there is no 3 second call.\",\"Reverse the ball slot to slot, then down to the wing.\",\"The post always posts on the new ball side.\",\"As the ball comes back up, the weak side player flashes.\"],\n steps:[\n {o:{o1:[150,295],o2:[350,295],o3:[255,165],o4:[75,205],o5:[345,100]},ball:\"o1\",t:\"Start: the pass to {3} in the paint is denied.\"},\n {o:{o3:[462,50]},t:\"{3} clears back out to the corner so there is no 3 second call.\"},\n {ball:\"o2\",t:\"{1} reverses the ball to {2} in the other slot.\"},\n {o:{o3:[425,205],o4:[155,100]},ball:\"o3\",t:\"{3} lifts from the corner and {2} swings it to her. {5} posts up on the new ball side block and {4} slides to the weak side block.\"},\n {o:{o4:[250,165],o5:[160,100]},ball:\"o2\",t:\"As the ball goes back to {2}, {4} flashes into the paint and {5} slips to the weak side block.\"},\n {ball:\"o4\",t:\"{2} hits {4} on the flash for the shot or the high low to {5}.\"}\n ]},\n{id:\"pace\",vids:[[\"7SffbISA540\", \"4 Out sets vs the 2 3 zone: Toronto Raptors\"], [\"EHjsdNLtJgY\", \"Motion offense vs 3 2 and 1 2 2 zones\"]],sys:\"z41\",name:\"Pace\",target:\"2 3, 1 3 1, or 1 2 2 zone\",look:\"Gap drives, corner 3, low post dive\",def:\"23\",\n keys:[\"True 4 Out spacing: guards wide in the slots, {3} and {4} in the corners.\",\"Ball in a slot: {5} sits at the ball side elbow. Ball in the corner: {5} dives to the ball side post.\",\"Do not hold it. Quick, crisp passes and skip passes shift the zone faster than it can recover.\",\"Attack the gaps once the zone over shifts.\",\"Against a 1 3 1, the guards overload the top defender and the corners stay deep. Against a 1 2 2, {5} lives in the middle of the box.\"],\n steps:[\n {o:{o1:[150,295],o2:[350,295],o3:[38,50],o4:[462,50],o5:[172,222]},ball:\"o1\",t:\"Setup: 4 Out, 1 In. {1} and {2} wide in the slots, {3} and {4} in the corners. With the ball in the slot, {5} sits at the ball side elbow.\"},\n {o:{o5:[155,100]},ball:\"o3\",t:\"{1} passes to {3} in the corner, so {5} dives to the ball side low post.\"},\n {o:{o5:[250,205]},ball:\"o1\",t:\"Quick reversal. {3} moves it right back to {1} and {5} comes up the lane.\"},\n {o:{o5:[328,222]},ball:\"o2\",t:\"{1} to {2} without holding it. {5} settles at the new ball side elbow.\"},\n {o:{o5:[345,100]},ball:\"o4\",t:\"{2} to {4} in the corner and {5} dives to the ball side post.\"},\n {ball:\"o2\",t:\"{4} moves it right back up to {2}.\"},\n {ball:\"o3\",t:\"The zone has over shifted. {2} throws the skip pass to {3} in the far corner.\"},\n {o:{o3:[120,165]},t:\"{3} attacks the open gap before the zone recovers: pull up, kick, or dump it inside.\"}\n ]},\n{id:\"corner\",vids:[[\"_n44_VAi-NE\", \"4 simple plays to beat a 2 3 zone\"], [\"YPwgU6mBDjA\", \"5 plays to punish a 2 3 zone\"]],sys:\"z41\",name:\"Corner\",target:\"2 3 zone\",look:\"Open corner 3\",def:\"23\",\n keys:[\"The corner pass pulls the low defender out.\",\"{2} dribbles up hard enough to drag that defender with her.\",\"{1} cuts underneath into the empty corner.\",\"Shot fake if the defender recovers, then drive the baseline.\"],\n steps:[\n {o:{o1:[150,295],o2:[38,50],o3:[350,295],o4:[462,50],o5:[345,100]},ball:\"o1\",t:\"Setup: 4 Out, 1 In. {1} and {3} wide in the slots, {2} and {4} in the corners, {5} on the block.\"},\n {ball:\"o2\",t:\"{1} passes to {2} in the corner, pulling the low defender out.\"},\n {o:{o2:[82,198],o1:[38,50]},via:{o1:[[125,125]]},t:\"{2} dribbles up toward the free throw line extended and drags the low defender with her. {1} cuts underneath {2} into the empty corner.\"},\n {ball:\"o1\",t:\"{2} passes right back to {1} in the corner.\"},\n {shot:true,t:\"{1} shoots the open corner 3.\"}\n ]},\n{id:\"middle\",vids:[[\"_n44_VAi-NE\", \"4 simple plays to beat a 2 3 zone\"], [\"YPwgU6mBDjA\", \"5 plays to punish a 2 3 zone\"]],sys:\"z41\",name:\"Middle\",target:\"2 3 zone\",look:\"Wing drive to the basket or corner 3\",def:\"23\",\n keys:[\"{5} flashes from the lane to the top of the key. The catch up top pulls the top defenders together.\",\"{1} and {3} stay spaced wide on the wings, with {2} and {4} deep in the corners.\",\"{5} kicks it right to {3} while {1} comes across to set the pin down screen for {3}.\",\"{3} attacks the basket off the screen. If the low defender steps up to stop her, kick it out to the open corner.\"],\n steps:[\n  {o:{o1:[75,205],o2:[462,50],o3:[425,205],o4:[38,50],o5:[250,150]},ball:\"o1\",t:\"Setup: 4 Out, 1 In. {1} and {3} spaced out on the wings, {2} and {4} deep in the corners, {5} in the middle of the lane. {1} has the ball.\"},\n  {o:{o5:[250,300]},t:\"{5} flashes from the lane up to the top of the key.\"},\n  {ball:\"o5\",t:\"{1} passes to {5} at the top of the key.\"},\n  {o:{o1:[385,182]},via:{o1:[[200,250],[320,235]]},ball:\"o3\",scr:[\"o1\"],t:\"{5} kicks it to {3} on the far wing while {1} comes across to set the pin down screen for {3}.\"},\n  {o:{o3:[290,165]},via:{o3:[[372,252]]},xo:{x4:[322,142],x5:[262,120]},t:\"{3} comes off the screen and attacks the basket. Defensive player {x4}, the low defender, steps up to stop her.\"},\n  {ball:\"o2\",t:\"The corner is open, so {3} kicks it out to {2}.\"},\n  {shot:true,t:\"{2} shoots the corner 3.\"}\n ]},\n{id:\"line\",vids:[[\"YPwgU6mBDjA\", \"5 plays to punish a 2 3 zone\"], [\"_n44_VAi-NE\", \"4 simple plays to beat a 2 3 zone\"]],sys:\"z41\",name:\"Line\",target:\"2 3 zone\",look:\"Corner 3 or baseline drive\",def:\"23\",\n keys:[\"{1}'s dribble engages the top defender and forces the other to cover.\",\"{3} steps out of the high post to be the reversal.\",\"Swing it fast. The zone cannot shift as quickly as the ball.\",\"{3} dives right after she swings it for the low post feed.\"],\n steps:[\n {o:{o1:[350,295],o2:[462,50],o3:[250,205],o4:[38,50],o5:[150,295]},ball:\"o1\",t:\"Setup: 4 Out, 1 In. {1} and {5} wide in the slots, {2} and {4} in the corners, {3} in the high post.\"},\n {o:{o1:[405,250]},t:\"{1} dribbles toward the wing to engage the top defender and force the other top defender to cover the next pass.\"},\n {o:{o3:[250,305]},ball:\"o3\",t:\"{3} steps out from the high post to the top of the key and catches from {1}.\"},\n {ball:\"o5\",t:\"{3} swings it quickly to {5} in the slot.\"},\n {ball:\"o4\",t:\"The defender closes out on {5}, so {5} passes down to {4} in the corner for the 3 or a baseline drive.\"},\n {o:{o3:[175,110]},ball:\"o3\",t:\"{3} dives down the lane to the low post for the feed from {4}.\"},\n {shot:true,t:\"{3} scores inside.\"}\n ]},\n{id:\"fiftytwo\",vids:[[\"_n44_VAi-NE\", \"4 simple plays to beat a 2 3 zone\"], [\"YPwgU6mBDjA\", \"5 plays to punish a 2 3 zone\"]],sys:\"z41\",name:\"52\",target:\"2 3 zone\",look:\"Seam jumper or low block pass\",def:\"23\",\n keys:[\"52 means {5} screens for {2}.\",\"The screen goes on the top defender in the gap.\",\"{4}'s baseline cut has to be under the zone, behind the defense.\",\"{2} reads: pull up, kick to {3} in the corner if the low defender drops, feed {4} if the middle steps up.\"],\n steps:[\n {o:{o1:[150,295],o2:[350,295],o3:[462,50],o4:[38,50],o5:[250,205]},ball:\"o1\",t:\"Setup: 4 Out, 1 In. {1} and {2} wide in the slots, {3} and {4} in the corners, {5} in the high post.\"},\n {o:{o5:[312,262]},ball:\"o2\",scr:[\"o5\"],t:\"{1} passes to {2} as {5} slides up and sets a gap screen on the top defender.\"},\n {o:{o4:[340,98]},via:{o4:[[150,64],[260,64]]},t:\"{3} holds the corner. {4} cuts along the baseline underneath the zone to the ball side block.\"},\n {o:{o2:[282,205]},via:{o2:[[300,250]]},t:\"{2} drives the seam off the screen. Options: pull up, kick to {3} if the low defender drops, or feed {4} if the middle defender steps up.\"},\n {ball:\"o4\",t:\"The middle defender stepped up, so {2} feeds {4} on the block.\"},\n {shot:true,t:\"{4} finishes.\"}\n ]},\n/* MAN DEFENSE */\n{id:\"shadow\",vids:[[\"ES7MVSegkSs\",\"Help side principles in man defense\"],[\"VfIdn8Lk3q8\",\"Help, sink, and recover\"],[\"gbb9CoEMF7s\",\"Rebounding and box out drills\"]],sys:\"man\",name:\"Shadow\",call:\"SHADOW\",target:\"Straight man to man\",look:\"Contested, low percentage shots\",def:\"man\",xArrows:true,\n keys:[\"Each defensive player guards the player with her number: defensive player {x1} guards {1}, defensive player {x2} guards {2}, and so on.\",\"No switching. Fight over or under ball screens per the scouting report and fight through every down screen.\",\"Pressure the ball without getting beat. Force it to the sideline or baseline.\",\"Keep the ball, you, man triangle and jump to the ball on every pass.\",\"The lowest help defender crosses the key line on drives. Sink and fill.\"],\n steps:[\n {o:OFF,ball:\"o1\",t:\"Straight man. Defensive player {x1} pressures {1} on the ball without getting beat. Off the ball: see ball, you, and your man.\"},\n {ball:\"o2\",t:\"{1} passes to {2} on the wing. Everyone jumps to the ball on the pass to shorten the help.\"},\n {o:{o2:[405,98]},xo:{x5:[305,102]},t:\"{2} drives baseline. Defensive player {x5}, the lowest help defender, crosses the key line and stops it.\"},\n {ball:\"o4\",t:\"{2} kicks the ball to {4} in the corner. Rotate, sink and fill, and close out with high hands.\"},\n {shot:true,dm:\"boxout\",t:\"The shot goes up. Every defensive player makes contact, boxes out, and finishes with a two hand rebound.\"}\n ]},\n{id:\"dark\",vids:[[\"TerW88zXBuM\",\"Match up zone: disguising your defense\"],[\"IXVUmXPa8mg\",\"Zone vs man to man defense\"]],sys:\"man\",name:\"Dark\",call:\"DARK\",target:\"Teams running set plays\",look:\"Confused offense, bad decisions\",def:\"man\",xArrows:true,\n keys:[\"Pick up in tight Shadow as soon as the ball crosses half court.\",\"On the second pass (or the first wing kickout), the safety calls DARK! DARK! loud and clear.\",\"All five drop into the 2 3 zone shell unless another zone was signaled, and match up with the nearest player.\",\"The goal is to make them run a man play into a zone.\"],\n steps:[\n {o:OFF,ball:\"o1\",t:\"Pick up in tight Shadow man as soon as the ball enters the half court. Each defensive player is on the player with her number.\"},\n {ball:\"o2\",t:\"First pass, {1} to {2}. Still man.\"},\n {ball:\"o4\",dm:\"23\",t:\"Second pass, {2} to {4}. The safety echoes DARK! DARK! and all five defensive players drop into the 2 3 zone shell.\"},\n {ball:\"o2\",t:\"Now the offense is running its man set into a zone.\"}\n ]},\n{id:\"blackout\",vids:[[\"nN7M6ewFqJg\",\"Fundamentals of denying the pass: Isiah Thomas\"],[\"gO8DX6vcwAE\",\"Deny and disrupt: half court denial man defense\"]],sys:\"man\",name:\"Blackout\",call:\"BLACKOUT\",target:\"Ball handlers who can be rattled\",look:\"Denied touches and panic\",def:\"deny\",xArrows:true,\n keys:[\"Suffocating ball pressure. Turn the handler at least twice before half court.\",\"High hip in every passing lane. Deny the easy perimeter entry.\",\"Stay closer to your player than normal. Help only on a dead drive.\",\"Hit someone on every shot.\"],\n steps:[\n {o:{o1:[250,330],o2:[425,230],o3:[75,230],o4:[400,100],o5:[155,100]},ball:\"o1\",t:\"Defensive player {x1} puts suffocating pressure on {1}. Every other defensive player sits on the high hip in the passing lane.\"},\n {o:{o1:[335,338]},t:\"Defensive player {x1} turns the ball handler. There is nowhere easy to go.\"},\n {o:{o2:[435,322]},t:\"{2} pops out high from the wing. Defensive player {x2} stays attached and keeps denying.\"},\n {o:{o2:[330,100]},via:{o2:[[440,200]]},t:\"{2} goes backdoor. Defensive player {x2} stays on her hip. Help only on a dead drive.\"}\n ]},\n/* ZONE DEFENSE */\n{id:\"z23\",vids:[[\"fQJBgJVhzp8\",\"How to teach an effective 2 3 zone\"],[\"YbHngANT7Qg\",\"Villanova's rules for the 2 3 zone\"]],sys:\"zone\",name:\"23\",call:\"23\",target:\"Teams that live in the paint\",look:\"No easy baskets inside\",def:\"23\",xArrows:true,\n keys:[\"Guards (defensive players {x1} and {x2}) overlap at the high post and top of the key, pass off handlers, and contest top of the key shots.\",\"Wings (defensive players {x3} and {x4}) close out hard on wing shooters, drop to the short corner on skips, and sink to the opposite block when the ball is on the far side.\",\"The center (defensive player {x5}) owns the lane block to block: protect the rim, contest high post entries, and own the glass.\"],\n steps:[\n {o:OFF,ball:\"o1\",t:\"Ball up top with {1}. Defensive players {x1} and {x2}, the guards, match up on the ball and the high post.